\setbeamercolor{structure}{bg=unmgray1,fg=unmred2}
\setbeamercolor{palette primary}{bg=unmred1, fg=unmwhite1}
\setbeamercolor{palette secondary}{bg=unmgray1, fg=unmgray1}
\setbeamercolor{palette tertiary}{bg=unmred2, fg=unmgray1}
\setbeamercolor{palette quaternary}{bg=unmred3, fg=unmwhite1}
\setbeamercolor{section in toc}{fg=black,bg=white}
\setbeamercolor{alerted text}{use=structure,fg=structure.fg!50!black!80!black}
\setbeamercolor{titlelike}{parent=palette primary,fg=structure.fg!50!black}
\setbeamercolor{frametitle}{bg=unmred1!10!unmwhite1,fg=unmgray1}

\usefonttheme[onlymath]{serif}

\setbeamertemplate{headline}{%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=\paperwidth,ht=2.5ex,dp=1.125ex]{palette quaternary}%
      \insertsectionnavigationhorizontal{\paperwidth}{}{\hskip0pt plus1filll}%
    \end{beamercolorbox}%
  }%
}%

\setbeamertemplate{navigation symbols}{}

\addtobeamertemplate{navigation symbols}{}{%
  \usebeamerfont{footline}%
  \usebeamercolor[fg]{footline}%
  \hspace{1em}%
  {\scriptsize\insertframenumber/\inserttotalframenumber}%
}%

\setbeamertemplate{footline}{}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{notation}{Notation}[section]
\newtheorem*{remark}{Remark}

\newcommand*{\theorembreak}{%
  \usebeamertemplate{theorem end}%
  \framebreak%
  \usebeamertemplate{theorem begin}%
}%
\newcommand*{\definitionbreak}{%
  \usebeamertemplate{definition end}%
  \framebreak%
  \usebeamertemplate{definition begin}%
}%
